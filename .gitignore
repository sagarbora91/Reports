# Node
node_modules/
npm-debug.log*

# Capacitor — android/ is generated by `npx cap add android` in CI;
# regenerated on every build to keep the repo clean.
android/
ios/

# Build outputs
*.apk
*.aab
*.ipa
build/
dist/

# SQLite web/preview engine — sql.js wasm is CI-generated (npm run copy-wasm), never
# committed. Ignore only the generated files (not the whole assets/ dir, so static
# assets like self-hosted fonts CAN be committed for offline branding).
greetor/www/assets/sql-wasm.js
greetor/www/assets/sql-wasm.wasm
greetor/www/assets/pdfmake.min.js
greetor/www/assets/vfs_fonts.js
greetor/www/assets/pdf.min.js
greetor/www/assets/pdf.worker.min.js

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml

# Documentation scratch (keep the .docx originals)
Documentation/_extract_*.txt
Documentation/_p1_spec_summary.md

# Claude project memory (lives outside repo)
.claude/

# Secrets
.env
.env.*
*.keystore
*.jks

# QA harness — generated artifacts (keep shim.js + tests.js + gen/stress sources)
qa/app_bundle.js
qa/run.js
qa/gen_run.js
qa/stress_run.js
qa/demo_state.json
